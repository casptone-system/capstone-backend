APP_NAME="ADAMS Archiving System"
INSTITUTION_NAME="Isabela State University"
INSTITUTION_CAMPUS="Echague Main Campus"
INSTITUTION_RESPONDENT_UNIT="Institute of Fisheries"
INSTITUTION_RESPONDENT_UNIT_CODE=IOF
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:8000,localhost:8080,127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=capstone
DB_USERNAME=root
DB_PASSWORD=
# Railway MySQL (private network). Prefer these over MYSQL_PUBLIC_URL:
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_DATABASE=${{MySQL.MYSQLDATABASE}}
# DB_USERNAME=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# Or a single URL: DB_URL=${{MySQL.MYSQL_URL}}

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Evidence documents, role-storage vaults, and workspace criterion files.
# Keep `local` until Supabase (or R2) credentials are set, then switch to `s3`
# and run `php artisan storage:migrate-evidence --direction=to-r2 --sync`.
EVIDENCE_DISK=local
QUEUE_CONNECTION=sync
ENABLE_LOCAL_DB_BACKUP=false
SECURITY_FORCE_HTTPS=false

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="ADAMS Archiving System"

# Supabase Storage (S3-compatible). Production values for Railway:
# EVIDENCE_DISK=s3
# AWS_ACCESS_KEY_ID=<supabase-s3-access-key>
# AWS_SECRET_ACCESS_KEY=<supabase-s3-secret>
# AWS_BUCKET=accreditation-documents
# AWS_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
R2_ACCOUNT_ID=
# If AWS_ENDPOINT is empty, it is derived as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
DOCUMENT_UPLOAD_MAX_KB=51200
AREA_DOCUMENT_UPLOAD_MAX_KB=10240
AREA_DOCUMENT_MAX_FILES_PER_ROW=5
MEDIA_UPLOAD_MAX_KB=1048576
UPLOAD_CHUNK_SIZE_BYTES=8388608
UPLOAD_CHUNK_THRESHOLD_BYTES=52428800

VITE_APP_NAME="${APP_NAME}"
