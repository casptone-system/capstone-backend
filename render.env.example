# Set these on the Render adams-api service (Environment tab).
# Do not commit real secrets. Changes require a manual redeploy.

APP_NAME="ADAMS Archiving System"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://adams-api.onrender.com
FRONTEND_URL=https://isu-adams.pages.dev
APP_TIMEZONE=Asia/Manila
CORS_ALLOWED_ORIGINS=https://isu-adams.pages.dev
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_ENABLED=true

# Auth + invite email flags (default ON in production when omitted)
AUTH_2FA_ENABLED=true
AUTH_EMAIL_VERIFICATION_ENABLED=true
TEAM_INVITES_ENABLED=true
AUTH_2FA_ROLES=qa,vpaa,dean,program-chair,accreditor,faculty,area-in-charge
AUTH_2FA_EXEMPT_EMAILS=admin@example.com,superadmin@isu.edu.ph
INSTITUTIONAL_EMAIL_DOMAIN=isu.edu.ph

# Render free tier blocks SMTP ports 25/465/587.
# Use Brevo HTTPS API (free, no custom domain required after sender verification):
# 1) https://app.brevo.com/settings/keys/api
# 2) Verify sender: https://app.brevo.com/senders
# 3) MAIL_FROM_ADDRESS must be that verified sender email
MAIL_MAILER=brevo
BREVO_API_KEY=
MAIL_FROM_ADDRESS=jhimsonhaduca@gmail.com
MAIL_FROM_NAME="ADAMS Archiving System"

LOG_CHANNEL=stderr
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local
SECURITY_FORCE_HTTPS=true
SESSION_SECURE_COOKIE=true
ENABLE_LOCAL_DB_BACKUP=false

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=4000
DB_DATABASE=adams
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

EVIDENCE_DISK=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=accreditation-documents
AWS_BUCKET=accreditation-documents
