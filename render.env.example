# Set these on the Render adams-api service (Environment tab).
# Do not commit real secrets. Changes require a manual redeploy.

APP_NAME="ADAMS Archiving System"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://adams-api.onrender.com
FRONTEND_URL=https://isu-adams.pages.dev
APP_TIMEZONE=Asia/Manila
CORS_ALLOWED_ORIGINS=https://isu-adams.pages.dev

# Auth + invite email flags (default ON in production when omitted)
AUTH_2FA_ENABLED=true
AUTH_EMAIL_VERIFICATION_ENABLED=true
TEAM_INVITES_ENABLED=true
AUTH_2FA_ROLES=superadmin,qa,vpaa,dean,program-chair,accreditor
AUTH_2FA_EXEMPT_EMAILS=admin@example.com
INSTITUTIONAL_EMAIL_DOMAIN=isu.edu.ph

# Render free tier blocks SMTP ports 25/465/587. Use Resend over HTTPS instead.
# Create a free key at https://resend.com/api-keys
# Until a custom domain is verified, Resend only delivers from onboarding@resend.dev
# to the Resend account owner's inbox.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="ADAMS Archiving System"

# Optional local/paid-host SMTP fallback (blocked on Render free):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

LOG_CHANNEL=stderr
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local
SECURITY_FORCE_HTTPS=true
SESSION_SECURE_COOKIE=true
ENABLE_LOCAL_DB_BACKUP=false

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=4000
DB_DATABASE=adams
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

EVIDENCE_DISK=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=accreditation-documents
AWS_BUCKET=accreditation-documents
