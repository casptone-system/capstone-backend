# Set these on the Render adams-api service (Environment tab).
# APP_URL / FRONTEND_URL / CORS are filled after both hosts are live.

APP_KEY=
APP_URL=https://adams-api.onrender.com
FRONTEND_URL=https://<project>.pages.dev
CORS_ALLOWED_ORIGINS=https://<project>.pages.dev

DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

EVIDENCE_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=accreditation-documents
AWS_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
AWS_DEFAULT_REGION=ap-southeast-1
AWS_USE_PATH_STYLE_ENDPOINT=true
