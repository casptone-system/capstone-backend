# Copy these into the Railway Laravel service Variables tab.
# Replace bracketed placeholders after Hostinger, Railway MySQL, and Supabase are ready.

APP_NAME=ADAMS Archiving System
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://<your-railway-api-domain>
FRONTEND_URL=https://<your-hostinger-domain>
APP_TIMEZONE=Asia/Manila
CORS_ALLOWED_ORIGINS=https://<your-hostinger-domain>,https://www.<your-hostinger-domain>
SECURITY_FORCE_HTTPS=true
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=file
FILESYSTEM_DISK=local
EVIDENCE_DISK=s3
ENABLE_LOCAL_DB_BACKUP=false

DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

AWS_ACCESS_KEY_ID=<supabase-s3-access-key>
AWS_SECRET_ACCESS_KEY=<supabase-s3-secret>
AWS_BUCKET=accreditation-documents
AWS_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
AWS_DEFAULT_REGION=ap-southeast-1
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ADAMS Archiving System

# Required second Railway service (Worker): same repo and env vars as the web
# service. Start command:
#   php artisan queue:work --sleep=1 --tries=3 --timeout=90
# Login 2FA codes and assignment emails are queued. They will not send until
# this worker is running. Do not run the worker inside start.sh (web process).

# Optional second Railway service (Cron):
# Schedule: * * * * *
# Start command: php artisan schedule:run
