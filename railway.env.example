# Copy these into the Railway Laravel service Variables tab.
# Replace bracketed placeholders after Hostinger, Railway MySQL, and Supabase are ready.

APP_NAME=ADAMS Archiving System
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://<your-railway-api-domain>
FRONTEND_URL=https://<your-hostinger-domain>
APP_TIMEZONE=Asia/Manila
CORS_ALLOWED_ORIGINS=https://<your-hostinger-domain>,https://www.<your-hostinger-domain>
SECURITY_FORCE_HTTPS=true
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_ENABLED=true
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
AUTH_2FA_ENABLED=true
AUTH_EMAIL_VERIFICATION_ENABLED=true
TEAM_INVITES_ENABLED=true
AUTH_2FA_ROLES=superadmin,qa,vpaa,dean,program-chair,accreditor
AUTH_2FA_EXEMPT_EMAILS=admin@example.com
AUTH_TRUSTED_DEVICE_TTL_DAYS=90
AUTH_TRUSTED_DEVICE_MAX=10
INSTITUTIONAL_EMAIL_DOMAIN=isu.edu.ph
CACHE_STORE=file
FILESYSTEM_DISK=local
EVIDENCE_DISK=s3
ENABLE_LOCAL_DB_BACKUP=false

DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

AWS_ACCESS_KEY_ID=<supabase-s3-access-key>
AWS_SECRET_ACCESS_KEY=<supabase-s3-secret>
AWS_BUCKET=accreditation-documents
AWS_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
AWS_DEFAULT_REGION=ap-southeast-1
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ADAMS Archiving System

# Required second Railway service (Worker) when QUEUE_CONNECTION=database.
# Same repo and env vars as the web service. Restart policy: ON_FAILURE.
# Start command (split queues — mail backlog cannot starve default work):
#   php artisan queue:work database --queue=default,mail,exports --sleep=1 --tries=3 --timeout=90 --max-time=3600
# Platform restarts the process after crash/exit. --max-time keeps memory fresh.
# Assignment, comment, and upload emails use the mail queue. Login codes, email
# verification, and password resets stay synchronous on the web request.
# Do not run the worker inside start.sh (web process).
#
# Render free typically uses QUEUE_CONNECTION=sync (no worker). Side effects still
# leave the HTTP request via dispatch()->afterResponse().

# Optional second Railway service (Cron):
# Schedule: * * * * *
# Start command: php artisan schedule:run
